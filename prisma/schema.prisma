// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  password String?
  dateAdded DateTime @default(now())
  dateUpdated DateTime @updatedAt

  events Event[]
  withdrawals Withdrawal[]
  payoutAccounts PayoutAccount[]
  donations Donation[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}


model Event {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  title String
  description String
  category Event_Category
  date DateTime
  fundraiser Fundraiser?
  dateAdded DateTime @default(now())
  dateUpdated DateTime @updatedAt
}

enum Event_Category {
  COMMUNITY
  EDUCATIONAL
  ENVIRONMENT
  MEDICAL
  NONPROFIT
  EMERGENCY
  ANIMALS
  OTHER
}

model Fundraiser {
  id String @id @default(uuid())
  eventId String @unique
  event Event @relation(fields: [eventId], references: [id])
  // All money is stored as an integer number of pesewas (1 GHS = 100
  // pesewas). Never store money as a float. Use lib/money to convert at the
  // edges and formatGHS to display.
  targetAmount Int
  endDate DateTime
  anonymity Boolean
  minimumAmount Int
  image String?
  raisedAmount Int
  donorCount Int
  totalWithdrawn Int
  // ISO 4217 currency code. GHS today; a column so other Paystack markets
  // can be added without a migration.
  currency String @default("GHS")
  dateAdded DateTime @default(now())
  dateUpdated DateTime @updatedAt

  donations Donation[]
  withdrawals Withdrawal[]
}

model Donation {
  id String @id @default(uuid())
  // Paystack transaction reference. Unique so one payment can only be
  // recorded once. Nullable only for rows created before this column existed.
  reference String? @unique
  amount Int // pesewas
  currency String @default("GHS")
  fundraiserId String
  fundraiser Fundraiser @relation(fields: [fundraiserId], references: [id])
  // Set when a signed-in user donated, so "My donations" can link by user
  // rather than by the typed email.
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Per-donation choice: an anonymous gift stores no donor name or email and
  // is shown as "Anonymous".
  isAnonymous Boolean @default(false)
  donorFirstName String?
  donorLastName String?
  donorEmail String?
  paymentDetails Json
  dateAdded DateTime @default(now())
  dateUpdated DateTime @updatedAt

  @@index([userId])
  @@index([fundraiserId])
}

model Withdrawal {
  id String @id @default(uuid())
  amount Int // pesewas
  currency String @default("GHS")
  fundraiserId String
  fundraiser Fundraiser @relation(fields: [fundraiserId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  accountType Account_Type
  notes String?
  status Withdrawal_Status
  paymentDetails Json
  recipientCode String
  // Server-generated transfer reference. Unique so a transfer webhook maps to
  // exactly one withdrawal. Nullable only for rows created before this column.
  reference String? @unique
  payoutAccountId String?
  payoutAccount PayoutAccount? @relation(fields: [payoutAccountId], references: [id])
  dateAdded DateTime @default(now())
  dateUpdated DateTime @updatedAt
}

// A verified destination for a user's payouts. The account is resolved with
// Paystack and registered once as a transfer recipient; the recipientCode is
// what transfers are sent to.
model PayoutAccount {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountType Account_Type
  bankCode String
  bankName String?
  accountNumber String
  // The account holder's name as Paystack resolved it, not as typed.
  accountName String
  recipientCode String
  currency String @default("GHS")
  dateAdded DateTime @default(now())
  dateUpdated DateTime @updatedAt

  withdrawals Withdrawal[]

  @@unique([userId, recipientCode])
}

// Append-only record of every money movement (and, later, admin actions).
// The services only ever create rows here, inside the same transaction as the
// movement, so the log cannot disagree with the balances. Never updated or
// deleted.
model AuditLog {
  id String @id @default(uuid())
  createdAt DateTime @default(now())
  // A dotted action name, e.g. "donation.recorded", "withdrawal.reserved".
  action String
  // Who caused it: a user id, or null for a provider webhook / system job.
  actorUserId String?
  fundraiserId String?
  donationId String?
  withdrawalId String?
  // Signed pesewa change to the fundraiser's recorded balance where that is
  // meaningful (a donation is positive, a reserved withdrawal negative).
  amount Int?
  currency String?
  detail Json
  reference String?

  @@index([fundraiserId])
  @@index([withdrawalId])
}

enum Withdrawal_Status {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum Account_Type {
  MOBILE_MONEY
  BANK_ACCOUNT
}