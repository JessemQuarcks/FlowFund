# Copy to .env and fill in. Never commit real values.

# MySQL connection string used by Prisma. This value matches the MySQL
# started by `docker compose up -d`.
DATABASE_URL="mysql://root:flowfund@localhost:3307/flowfund"

# NextAuth: public URL of the app (optional on Vercel) and a long random secret
# (generate one with: openssl rand -base64 32)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary (event images)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Paystack: use test keys (sk_test_ / pk_test_) until roadmap Phase 2 is done.
# The webhook at /api/webhooks/paystack is verified with the secret key, so set
# that URL as the webhook in the Paystack dashboard for this account.
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# Optional. Shared secret that guards the reconciliation trigger
# (POST /api/cron/reconcile), sent by the scheduler as a Bearer token. At
# least 16 characters. Leave unset to disable the trigger.
CRON_SECRET=""

# Optional email delivery via Resend (https://resend.com). When unset, emails
# (password reset, contact, receipts) are logged instead of sent, so local dev
# works without a provider. EMAIL_FROM is the verified sender address.
RESEND_API_KEY=""
EMAIL_FROM=""
# Where the contact form delivers; falls back to EMAIL_FROM.
CONTACT_TO=""

# Integration and end-to-end tests only. Must be a disposable database whose
# name contains "test": every run drops all its tables.
TEST_DATABASE_URL="mysql://root:flowfund@localhost:3307/flowfund_test"
