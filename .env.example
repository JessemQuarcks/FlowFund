# Copy to .env and fill in. Never commit real values.

# MySQL connection string used by Prisma
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/flowfund"

# NextAuth: public URL of the app and a long random secret
# (generate one with: openssl rand -base64 32)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary (event images)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Paystack: use test keys (sk_test_ / pk_test_) until roadmap Phase 2 is done
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""
